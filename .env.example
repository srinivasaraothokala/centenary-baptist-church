# =============================================================================
# Centenary Baptist Church — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────

# Application environment. Must be 'production' on your live server.
# Controls CORS enforcement and static file serving.
NODE_ENV=development

# Port for the Express backend server.
PORT=3000

# ── CORS (Required in production) ─────────────────────────────────────────────

# Comma-separated list of allowed browser origins.
# REQUIRED when NODE_ENV=production — server will refuse to start without it.
# Examples:
#   Single origin:   CORS_ORIGIN=https://www.cbcsecbad.in
#   Multiple origins: CORS_ORIGIN=https://www.cbcsecbad.in,https://cbcsecbad.in
# In development, localhost:5173 and localhost:5174 are allowed automatically.
CORS_ORIGIN=

# ── Backend Supabase (Server-side only — NEVER expose to frontend) ────────────

# Your Supabase project URL.
SUPABASE_URL=

# Supabase service-role secret key. Grants full database access.
# NEVER put this value in any VITE_* variable or frontend code.
SUPABASE_SERVICE_KEY=

# ── Frontend Supabase (Safe to include in browser bundle) ─────────────────────

# Your Supabase project URL (same as above — duplicated for Vite).
VITE_SUPABASE_URL=

# Supabase anon/publishable key. This is safe for the browser.
VITE_SUPABASE_ANON_KEY=

# ── Frontend API Base URL (Optional) ─────────────────────────────────────────

# Optional. Overrides the default relative /api path for API requests.
# Only set this if your frontend and backend are hosted on different domains.
# If frontend and backend share the same domain/origin, leave this empty.
# Example: VITE_API_BASE_URL=https://api.cbcsecbad.in
VITE_API_BASE_URL=

# ── Analytics (Optional) ──────────────────────────────────────────────────────

# Google Analytics 4 Measurement ID. Leave empty to disable analytics.
# Example: VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# ── Email / SMTP (Required for contact form) ──────────────────────────────────

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
MAIL_FROM="Centenary Baptist Church" <no-reply@cbcsecbad.in>
CONTACT_EMAIL=support@cbcsecbad.in
